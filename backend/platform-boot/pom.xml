<?xml version="1.0" encoding="UTF-8"?>
<!-- 文件作用：装配后端业务模块、运行时数据库驱动和可执行 Spring Boot 应用。 -->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xtong.saas</groupId>
        <artifactId>saas-portal</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>platform-boot</artifactId>
    <name>platform-boot</name>

    <dependencies>
        <!-- Boot 装配 System 与 Business 业务模块，System 传递提供 Web、Validation、MyBatis 和 Redis。 -->
        <dependency>
            <groupId>com.xtong.saas</groupId>
            <artifactId>platform-system</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.xtong.saas</groupId>
            <artifactId>platform-business</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Boot 的运行状态监控端点。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Boot 连接生产 MySQL 所需的运行时驱动。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Boot 应用上下文和集成测试支持。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 将 Boot 模块打包为可直接运行的应用 JAR。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
